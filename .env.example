# Prism server configuration.
# Copy this file to server/.env and fill in the keys to enable LIVE generation.
# The server intentionally loads server/.env, not a repo-root .env file.

# Enables live LLM generation via OpenRouter (OpenAI-compatible API).
OPENROUTER_API_KEY=

# Model + reasoning effort. Defaults shown.
OPENROUTER_MODEL=openrouter/owl-alpha
OPENROUTER_REASONING=none

# Optional comma-separated fallback models. Empty means use only OPENROUTER_MODEL.
OPENROUTER_FALLBACK_MODELS=

# OpenRouter request timeout in milliseconds.
OPENROUTER_TIMEOUT_MS=480000

# Enables live US-equity market data for the neutral base layer.
ALPHAVANTAGE_API_KEY=

# Server port (frontend dev server proxies /api here).
PORT=8787

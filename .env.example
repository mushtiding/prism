# Prism server configuration.
# Copy this file to server/.env and fill in the keys to enable LIVE generation.
# The server intentionally loads server/.env, not a repo-root .env file.

# Enables live LLM generation via OpenRouter (OpenAI-compatible API).
OPENROUTER_API_KEY=

# Model + reasoning effort. Defaults shown.
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_REASONING=none

# Optional comma-separated fallback models.
# OPENROUTER_FALLBACK_MODELS=openrouter/free

# OpenRouter request timeout in milliseconds.
OPENROUTER_TIMEOUT_MS=480000

# Enables live US-equity market data for the neutral base layer.
ALPHAVANTAGE_API_KEY=

# Server port (frontend dev server proxies /api here).
PORT=8788

# Persona quality evaluation runs asynchronously after publication.
EVALUATION_JUDGE_ENABLED=true
EVALUATION_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Prior-day CSV reports use local server time.
EVALUATION_REPORT_HOUR=0
EVALUATION_REPORT_MINUTE=5

# Two automatic daily brief versions, interpreted in the server's local time.
AUTO_BRIEF_TIMES=09:30,13:30

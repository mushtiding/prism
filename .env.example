# Prism configuration. Copy to .env and fill in to enable LIVE generation.
# With either key missing, the app gracefully serves a bundled sample trading day.

# Enables live LLM generation via OpenRouter (OpenAI-compatible API).
OPENROUTER_API_KEY=

# Model + reasoning effort. Defaults shown.
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_REASONING=medium

# Enables live US-equity market data for the neutral base layer.
ALPHAVANTAGE_API_KEY=

# Server port (frontend dev server proxies /api here).
PORT=8787

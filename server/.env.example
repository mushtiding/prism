# Prism loads runtime configuration from server/.env.
OPENROUTER_API_KEY=
ALPHAVANTAGE_API_KEY=

OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free
# OPENROUTER_FALLBACK_MODELS=openrouter/free
# OPENROUTER_REASONING=none
# OPENROUTER_TIMEOUT_MS=480000

# Persona quality evaluation runs asynchronously after publication.
EVALUATION_JUDGE_ENABLED=true
EVALUATION_JUDGE_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Prior-day CSV reports use local server time.
EVALUATION_REPORT_HOUR=0
EVALUATION_REPORT_MINUTE=5

# Two automatic daily brief versions, interpreted in the server's local time.
AUTO_BRIEF_TIMES=09:30,13:30
